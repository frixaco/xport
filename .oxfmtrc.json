{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "embeddedLanguageFormatting": "auto",
  "proseWrap": "preserve",
  "sortTailwindcss": {
    "stylesheet": "web/app/globals.css",
    "functions": ["cn", "clsx", "cva", "twMerge"],
    "preserveWhitespace": false,
    "preserveDuplicates": false
  },
  "ignorePatterns": [
    "node_modules/**",
    ".output/**",
    ".tanstack/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "web/src/routeTree.gen.ts",
    "web/drizzle/**",
    "cli/data/**"
  ]
}
