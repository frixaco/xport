{
  "name": "@frixaco/xport",
  "version": "0.1.0",
  "description": "Server-backed CLI for exporting X (ex-Twitter) posts, threads, timelines, and articles.",
  "license": "MIT",
  "bin": {
    "xport": "./dist/cli/src/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "xport": "tsx src/index.ts",
    "prepack": "pnpm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "pnpm run format:check && pnpm run lint",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "fetch-thread": "tsx fetch-thread.ts",
    "fetch-article": "tsx fetch-article.ts",
    "fetch-user-info": "tsx fetch-user-info.ts",
    "fetch-posts": "tsx fetch-posts.ts",
    "fetch-posts-by-username": "tsx fetch-posts-by-username.ts",
    "fetch-replies": "tsx fetch-replies.ts",
    "fetch-followings": "tsx fetch-followings.ts",
    "fetch-bookmarks": "tsx fetch-bookmarks.ts",
    "fetch-user-tweets-via-mentions": "tsx fetch-user-tweets-via-mentions.ts",
    "add-to-list": "tsx add-to-list.ts"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  },
  "engines": {
    "node": ">=24"
  }
}
