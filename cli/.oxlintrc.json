{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "eslint/no-await-in-loop": "off"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["data/**"]
}
