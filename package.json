{
  "name": "xport",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "cli"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint && pnpm --filter cli lint",
    "check": "pnpm --filter web check && pnpm --filter cli check",
    "format": "pnpm --filter web format && pnpm --filter cli format",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:generate": "pnpm --filter web db:generate"
  },
  "devDependencies": {
    "@types/node": "^24",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0"
}
