{
  "name": "xport",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "core",
    "web",
    "cli"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter @xport/core lint && pnpm --filter web lint && pnpm --filter @frixaco/xport lint",
    "lint:fix": "pnpm --filter @xport/core lint:fix && pnpm --filter web lint:fix && pnpm --filter @frixaco/xport lint:fix",
    "format": "oxfmt --ignore-path .gitignore --write . '!web/src/routeTree.gen.ts'",
    "format:check": "oxfmt --ignore-path .gitignore --check . '!web/src/routeTree.gen.ts'",
    "check": "pnpm run format:check && pnpm run lint",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:generate": "pnpm --filter web db:generate",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^24",
    "knip": "^6.17.1",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tailwindcss": "^1.3.3",
    "typescript": "^6.0.3"
  }
}
